<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dip" />
            <gradient
                android:angle="270"
                android:centerColor="?attr/colorSurfaceVariant"
                android:centerY="0.75"
                android:endColor="?attr/colorSurfaceVariant"
                android:startColor="?attr/colorSurfaceVariant" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5dip" />
                <gradient
                    android:angle="270"
                    android:centerColor="?attr/colorPrimary"
                    android:centerY="0.75"
                    android:endColor="?attr/colorPrimary"
                    android:startColor="?attr/colorPrimary" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dip" />
                <gradient
                    android:angle="270"
                    android:endColor="?attr/colorPrimary"
                    android:startColor="?attr/colorPrimary" />
            </shape>
        </clip>
    </item>

</layer-list>
