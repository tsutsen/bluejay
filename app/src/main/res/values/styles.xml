<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Transparent theme for activities that don't need UI -->
    <style name="Theme.App.TransparentNoUi" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
    <!-- No action bar theme for Compose activities -->
    <style name="Theme.App.NoActionBar" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Extend into the camera-cutout area (short edges) so the
             landscape UI can be laid out around the punch-hole; the
             player top bar pads WindowInsets.displayCutout itself. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
