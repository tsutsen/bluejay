<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FutoVideo.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@null</item>
    </style>

    <style name="Theme.FutoVideo.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Theme.FutoVideo.CheckedTextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Theme.FutoVideo.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:background">@drawable/edit_text_background</item>
        <item name="android:textCursorDrawable">@drawable/edit_text_cursor</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Theme.FutoVideo.ListView" parent="Widget.AppCompat.ListView">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="Theme.FutoVideo" parent="Theme.Material3.DynamicColors.DayNight">
        <!-- DynamicColors automatically applies wallpaper-derived colors -->
        <!-- DarkUi keeps the dark video-player aesthetic with dynamic accent colors -->

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="imageButtonStyle">@style/Theme.FutoVideo.ImageButton</item>
        <item name="editTextStyle">@style/Theme.FutoVideo.EditText</item>
        <item name="android:listViewStyle">@style/Theme.FutoVideo.ListView</item>
        <item name="android:textViewStyle">@style/Theme.FutoVideo.TextView</item>
        <item name="android:checkedTextViewStyle">@style/Theme.FutoVideo.CheckedTextView</item>

        <!-- Custom attribute: always-white color for video player overlays -->
        <!-- Video player controls are overlaid on video content which can be dark or light -->
        <!-- This ensures they remain visible (white) in both light and dark themes -->
        <item name="colorVideoOverlay">#FFFFFFFF</item>

        <!-- Material3 text appearances inherited from parent -->
        <!-- Material3 shape appearances inherited from parent -->
    </style>

    <style name="Theme.FutoVideo.NoActionBar" parent="Theme.FutoVideo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarDividerColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.FutoVideo.NoActionBarFitsSystem" parent="Theme.FutoVideo.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.FutoVideo.TextAppearance.TabLayout" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">12dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Theme.FutoVideo.TextAppearance.EditText" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">20dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Theme.App.TransparentNoUi" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Material Symbols icon style settings -->
    <style name="Theme.FutoVideo.MaterialSymbol" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

</resources>